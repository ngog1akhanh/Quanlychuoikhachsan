    <Compile Include="../HotelAdmin.WinForms/Services/AppConfig.cs" Link="Client/AppConfig.cs" />
    <Compile Include="../HotelAdmin.WinForms/Services/UserSession.cs" Link="Client/UserSession.cs" />
  </ItemGroup>
</Project>
