@page "/rooms/{Id:long}"
@implements IDisposable
@inject RoomService RoomSvc
@inject HotelInfoService InfoSvc
@inject BookingState State
@inject NavigationManager Nav

<PageTitle>@(_room?.VariantName ?? "Chi tiết phòng") – @HotelInfo.Name</PageTitle>

<div class="container section">
    <p class="small"><a href="rooms?@State.Query.ToQueryString()">← Quay lại danh sách phòng</a></p>

    @if (_loading)
    {
        <Loading />
    }
    else if (_room is null)
    {
        <div class="empty">
            <p>@(_error ?? "Phòng này không còn trống trong khoảng thời gian đã chọn hoặc không tồn tại.")</p>
            <a class="btn btn-primary" href="rooms">Tìm phòng khác</a>
        </div>
    }
    else
    {
        var r = _room;
        var q = State.Query;
        <div class="layout-main-side">
            <div>
                <RoomGallery Images="RoomImages.Gallery(r)" Title="@r.VariantName" />

                <h1 class="mt-2">@r.VariantName</h1>

                <div class="spec-grid">
                    <div class="spec"><small>Diện tích</small><b>@(r.AreaM2 is null ? "—" : r.AreaM2.Value.ToString("0.#") + " m²")</b></div>
                    <div class="spec"><small>Sức chứa</small><b>@r.MaxAdults người lớn@(r.MaxChildren > 0 ? $" + {r.MaxChildren} trẻ em" : "")</b></div>
                    <div class="spec"><small>Giường</small><b>@r.BedLabel</b></div>

                </div>

                <div class="card card-body">
                    <div class="card-title">Mô tả</div>
                    <p>@r.VariantName · @r.BedLabel</p>

                    <div class="card-title mt-2">Tiện nghi</div>
                    <ul class="amenities">
                        @foreach (var a in Amenities)
                        {
                            <li>@a</li>
                        }
                    </ul>
                    <p class="muted small mt-1 mb-0">Danh sách tiện nghi mang tính tham khảo – backend hiện chưa trả tiện nghi riêng cho từng phòng.</p>
                </div>

                <div class="card card-body mt-2">
                    <div class="card-title">Giá dự kiến từng đêm</div>
                    <table class="table">
                        <thead><tr><th>Đêm</th><th>Giá</th></tr></thead>
                        <tbody>
                            @for (var d = q.CheckIn; d < q.CheckOut; d = d.AddDays(1))
                            {
                                var day = d;
                                var normal = r.NightPrices?.FirstOrDefault(n => n.StayDate == day)?.FinalPrice ?? r.UnitPrice;
                                var promo = _promoQuote?.Nights.FirstOrDefault(n => n.StayDate == day)?.FinalPrice;
                                <tr>
                                    <td>@Fmt.Weekday(d)</td>
                                    <td>
                                        @if (promo is { } p && p < normal)
                                        {
                                            <s class="muted">@Fmt.Money(normal)</s>
                                            <b class="price-new">@Fmt.Money(p)</b>
         }
                                        else
                                        {
                                            @Fmt.Money(normal)
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot><tr><td>Tổng @q.Nights đêm</td><td>@Fmt.Money(_promoQuote?.Total ?? r.UnitPrice * q.Nights)</td></tr></tfoot>
                    </table>
                    <p class="muted small mb-0">Giá chính thức từng đêm (theo bảng giá, cuối tuần, ngày lễ) do hệ thống chốt khi giữ phòng.</p>
                </div>
            </div>

            <aside class="sticky-side">
                <div class="card price-panel">
                    <div class="muted small">Giá mỗi đêm từ</div>
                    @if (HasPromo)
                    {
                        <div class="price-old"><s>@Fmt.Money(r.UnitPrice)</s></div>
                        <div class="big">@Fmt.Money(PromoNightly)</div>
                        <div class="promo-tag">Ưu đãi: @State.PromotionName</div>
                    }
                    else
                    {
                        <div class="big">@Fmt.Money(r.UnitPrice)</div>
                    }
                    <hr />
                    <div class="summary-row"><span>Nhận phòng</span><b>@Fmt.Date(q.CheckIn)</b></div>
                    <div class="summary-row"><span>Trả phòng</span><b>@Fmt.Date(q.CheckOut)</b></div>
                    <div class="summary-row"><span>Khách</span><b>@q.Adults NL@(q.Children > 0 ? $", {q.Children} TE" : "")</b></div>

                    <div class="summary-row qty-row">
                        <span>Số phòng</span>
                        <div class="qty-stepper" role="group" aria-label="Số phòng">
                            <button type="button" class="qty-btn" disabled="@(_qty <= 1 || _quoting)" @onclick="() => ChangeQtyAsync(-1)" aria-label="Bớt một phòng">−</button>
                            <span class="qty-value">@_qty</span>
                            <button type="button" class="qty-btn" disabled="@(_qty >= MaxQty || _quoting)" @onclick="() => ChangeQtyAsync(1)" aria-label="Thêm một phòng">+</button>
                        </div>
                    </div>
                    <p class="muted small mb-0 text-right">Còn trống @MaxQty phòng loại này</p>

                    @if (HasPromo)
                    {
                        <div class="summary-row"><span class="muted">Giá gốc</span><s class="muted">@Fmt.Money(BaseTotal)</s></div>
                    }
                    <div class="summary-row total"><span>Tạm tính</span><span>@Fmt.Money(Total)</span></div>
                    <div class="summary-row deposit"><span>Tiền cọc (@((HotelInfo.DepositRate * 100).ToString("0"))%)</span><b>@Fmt.Money(Math.Round(Total * HotelInfo.DepositRate, 0))</b></div>

                    <button type="button" class="btn btn-primary btn-lg btn-block mt-2" disabled="@_quoting" @onclick="BookNow">
                        Đặt @(_qty > 1 ? $"{_qty} phòng" : "phòng này")
                    </button>

                    <button type="button" class="btn btn-outline btn-block mt-1" @onclick="TogglePromotionsAsync">
                        @(_showPromos ? "Ẩn ưu đãi" : HasPromo ? "Đổi ưu đãi" : "Áp dụng ưu đãi")
                    </button>

                    @if (_showPromos)
                    {
                        <div class="promo-list mt-1">
                            @if (_promos is null)
                            {
                                <Loading Message="Đang tải ưu đãi..." />
                            }
                            else if (_promos.Count == 0)
                            {
                                <p class="muted small mb-0">Hiện không có ưu đãi nào áp dụng cho loại phòng và ngày bạn chọn.</p>
                            }
                            else
                            {
                                @foreach (var p in _promos)
                                {
                                    var promo = p;
                                    var active = State.PromotionId == promo.Id;
                                    <div class="promo-item @(active ? "active" : "")">
                                        <div>
                                            <b>@promo.Name</b>
                                            <div class="small">@promo.Summary</div>
                                            <div class="small muted">@promo.Period</div>
                                        </div>
                                        <button type="button" class="btn btn-sm @(active ? "btn-outline" : "btn-primary")"
                                                disabled="@(active || _quoting)" @onclick="() => ApplyPromotionAsync(promo)">
                                            @(active ? "Đang dùng" : "Áp dụng")
                                        </button>
                                    </div>
                                }
                                <p class="muted small mb-0">Mỗi lần đặt chỉ dùng được 1 ưu đãi.</p>
                            }
                            @if (State.PromotionId is not null)
                            {
                                <button type="button" class="btn btn-outline btn-block btn-sm mt-1" disabled="@_quoting" @onclick="RemovePromotion">Bỏ ưu đãi</button>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_promoError))
                    {
                        <div class="alert alert-danger small mt-1">@_promoError</div>
                    }
                </div>
            </aside>
        </div>
    }
</div>

@code {
    [Parameter] public long Id { get; set; }

    [SupplyParameterFromQuery(Name = "checkIn")] public string? CheckInText { get; set; }
    [SupplyParameterFromQuery(Name = "checkOut")] public string? CheckOutText { get; set; }
    [SupplyParameterFromQuery(Name = "adults")] public int? AdultsValue { get; set; }
    [SupplyParameterFromQuery(Name = "children")] public int? ChildrenValue { get; set; }

    private static readonly string[] Amenities =
    {
        "Wi-Fi miễn phí", "Điều hòa nhiệt độ", "Smart TV", "Minibar", "Két an toàn",
        "Máy sấy tóc", "Dép & đồ vệ sinh cá nhân", "Bàn làm việc", "Ấm đun nước, trà & cà phê"
    };

    private PublicRoom? _room;
    private bool _loading = true;
    private string? _error;

    // Số phòng cùng loại + cùng kiểu giường (giống thẻ phòng ở trang danh sách)
    private int _qty = 1;
    private List<PublicRoom> Group => _room is null ? [] :
        State.Results.Where(x => x.GroupKey == _room.GroupKey)
            .OrderBy(x => x.Id == _room.Id ? 0 : 1).ThenBy(x => x.UnitPrice).ThenBy(x => x.Id).ToList();
    private int MaxQty => Math.Max(1, Group.Count);
    private List<PublicRoom> ChosenRooms => Group.Take(_qty).ToList();

    // Ưu đãi
    private bool _showPromos;
    private bool _quoting;
    private string? _promoError;
    private IReadOnlyList<RoomPromotion>? _promos;
    private RoomQuote? _promoQuote; // báo giá ưu đãi của phòng đang xem (bảng giá từng đêm)

    private decimal BaseTotal => ChosenRooms.Sum(x => x.UnitPrice) * State.Query.Nights;
    private bool HasPromo => State.PromotionId is not null && ChosenRooms.Count > 0 && ChosenRooms.All(x => State.PromoTotal(x.Id) is not null)
                             && Total < BaseTotal;
    private decimal Total => ChosenRooms.Sum(x => State.PromoTotal(x.Id) ?? x.UnitPrice * State.Query.Nights);
    private decimal PromoNightly => _room is null || State.Query.Nights == 0 ? 0
        : Math.Round((State.PromoTotal(_room.Id) ?? _room.UnitPrice * State.Query.Nights) / State.Query.Nights, 0);

    protected override void OnInitialized() => State.Changed += OnStateChanged;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var q = (CheckInText is not null || CheckOutText is not null)
                ? RoomSearchQuery.FromUrl(CheckInText, CheckOutText, AdultsValue, ChildrenValue)
                : State.Query.Clone();

            _room = State.Results.FirstOrDefault(r => r.Id == Id);
            if (_room is null || !State.Query.SameAs(q))
            {
                // Vào thẳng link chi tiết (hoặc F5) → tìm lại theo điều kiện trong URL
                var rooms = await RoomSvc.SearchAvailableAsync(q);
                State.SetResults(q, rooms);
                _room = rooms.FirstOrDefault(r => r.Id == Id);
            }
            if (_room is not null)
            {
                _qty = Math.Clamp(Group.Count(x => State.IsSelected(x.Id)), 1, MaxQty);
                _promos = null;
                _showPromos = false;
                if (State.PromotionId is { } promoId) await QuoteChosenAsync(promoId, State.PromotionName ?? "");
            }
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _room = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ChangeQtyAsync(int delta)
    {
        _qty = Math.Clamp(_qty + delta, 1, MaxQty);
        // Phòng mới thêm cũng cần giá ưu đãi do API báo
        if (State.PromotionId is { } promoId) await QuoteChosenAsync(promoId, State.PromotionName ?? "");
    }

    private async Task TogglePromotionsAsync()
    {
        _showPromos = !_showPromos;
        _promoError = null;
        if (_showPromos && _promos is null && _room is not null)
            _promos = await InfoSvc.GetRoomPromotionsAsync(_room.RoomTypeCode, State.Query.CheckIn, State.Query.CheckOut);
    }

    private Task ApplyPromotionAsync(RoomPromotion promo) => QuoteChosenAsync(promo.Id, promo.Name);

    /// <summary>Hỏi API giá sau ưu đãi cho từng phòng đang chọn; chỉ 1 ưu đãi – áp dụng cái mới thì thay cái cũ.</summary>
    private async Task QuoteChosenAsync(long promoId, string name)
    {
        if (_room is null) return;
        _quoting = true;
        _promoError = null;
        try
        {
            var quotes = new List<RoomQuote>();
            foreach (var room in ChosenRooms)
                if (await RoomSvc.QuoteAsync(room.Id, State.Query, promoId) is { } quote) quotes.Add(quote);
            if (quotes.Count == 0) { _promoError = "Chế độ dữ liệu mẫu không hỗ trợ ưu đãi."; return; }
            State.SetPromotion(promoId, name, quotes);
            _promoQuote = quotes.FirstOrDefault(x => x.RoomId == _room.Id);
        }
        catch (ApiException ex)
        {
            _promoError = ex.Message;
            State.ClearPromotion();
            _promoQuote = null;
        }
        finally
        {
            _quoting = false;
        }
    }

    private void RemovePromotion()
    {
        State.ClearPromotion();
        _promoQuote = null;
        _promoError = null;
    }

    private void BookNow()
    {
        if (_room is null) return;
        State.SelectGroup(_room.GroupKey, ChosenRooms);
        Nav.NavigateTo("checkout");
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnStateChanged;
}
