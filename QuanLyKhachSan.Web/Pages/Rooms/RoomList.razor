@page "/rooms"
@implements IDisposable
@inject RoomService RoomSvc
@inject BookingState State
@inject NavigationManager Nav

<PageTitle>Tìm phòng – @HotelInfo.Name</PageTitle>

<div class="container section">
    <RoomSearchForm Query="_form" OnSearch="SearchAsync" Busy="_loading" Compact="true" />

    @if (_loading)
    {
        <Loading Message="Đang tìm phòng trống..." />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else if (State.HasSearched)
    {
        <div class="results-head">
            <h2>Chọn hạng phòng</h2>
            <span class="muted">@Fmt.Date(State.Query.CheckIn) → @Fmt.Date(State.Query.CheckOut) · @State.Query.Nights đêm · @State.Query.Adults người lớn@(State.Query.Children > 0 ? $", {State.Query.Children} trẻ em" : "")</span>
        </div>

        @if (Groups.Count == 0)
        {
            <div class="empty">Không có phòng phù hợp. Hãy thử đổi ngày, số khách.</div>
        }
        else
        {
            <div class="room-type-grid">
                @foreach (var group in Groups)
                {
                    <RoomTypeCard @key="group[0].RoomTypeCode" Rooms="group" Query="State.Query" State="State" />
                }
            </div>
        }
    }
</div>

@if (State.SelectedCount > 0)
{
    <div class="cart-bar">
        <div class="container">
            <span>Đã chọn <b>@State.SelectedCount phòng</b> · @State.Query.Nights đêm · tạm tính <b>@Fmt.Money(State.EstimatedTotal)</b></span>
            <span>
                <button type="button" class="btn btn-outline btn-sm" @onclick="State.ClearSelection">Bỏ chọn tất cả</button>
                <a class="btn btn-primary" href="checkout">Đặt phòng đã chọn →</a>
            </span>
        </div>
    </div>
}

@code {

    [SupplyParameterFromQuery(Name = "checkIn")] public string? CheckInText { get; set; }
    [SupplyParameterFromQuery(Name = "checkOut")] public string? CheckOutText { get; set; }
    [SupplyParameterFromQuery(Name = "adults")] public int? AdultsValue { get; set; }
    [SupplyParameterFromQuery(Name = "children")] public int? ChildrenValue { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string? TypeCode { get; set; }

    private RoomSearchQuery _form = new();
    private bool _loading;
    private string? _error;

    private List<List<PublicRoom>> Groups => State.Results
        .GroupBy(r => r.RoomTypeCode).Select(g => g.OrderBy(r => r.UnitPrice).ThenBy(r => r.Id).ToList())
        .OrderBy(g => g[0].UnitPrice).ToList();

    protected override void OnInitialized() => State.Changed += OnStateChanged;

    protected override async Task OnParametersSetAsync()
    {
        var hasUrlQuery = CheckInText is not null || CheckOutText is not null;
        var q = hasUrlQuery ? RoomSearchQuery.FromUrl(CheckInText, CheckOutText, AdultsValue, ChildrenValue) : State.Query.Clone();

        if (q.CheckIn < DateOnly.FromDateTime(DateTime.Today))
        {
            // Link cũ có ngày quá khứ → dời về mặc định
            q = new RoomSearchQuery { Adults = q.Adults, Children = q.Children };
        }

        _form = q.Clone();

        // Chỉ gọi API khi chưa tìm hoặc điều kiện đổi
        if (!State.HasSearched || !State.Query.SameAs(q))
            await RunSearchAsync(q);
    }

    private async Task RunSearchAsync(RoomSearchQuery q)
    {
        _loading = true;
        _error = null;
        try
        {
            var rooms = await RoomSvc.SearchAvailableAsync(q);
            State.SetResults(q, rooms);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    // Người dùng bấm "Tìm phòng": cập nhật URL để có thể chia sẻ / F5
    private Task SearchAsync(RoomSearchQuery q)
    {
        Nav.NavigateTo("rooms?" + q.ToQueryString());
        return Task.CompletedTask;
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnStateChanged;
}
