@page "/account/profile"
@inject AuthState Auth
@inject CustomerService CustomerSvc
@inject NavigationManager Nav

<PageTitle>Hồ sơ cá nhân – @HotelInfo.Name</PageTitle>

<div class="container section" style="max-width:820px">
    <h1 class="page-title">Hồ sơ cá nhân</h1>

    @if (_loading)
    {
        <Loading />
    }
    else
    {
        <div class="tabs">
            <button type="button" class="chip @(_tab == "info" ? "on" : "")" @onclick='() => _tab = "info"'>Thông tin cá nhân</button>
            <button type="button" class="chip @(_tab == "pwd" ? "on" : "")" @onclick='() => _tab = "pwd"'>Đổi mật khẩu</button>
            <a class="chip" href="account/bookings">Lịch sử đặt phòng</a>
        </div>

        @if (!string.IsNullOrEmpty(_warning))
        {
            <div class="alert alert-warn">@_warning</div>
        }
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @(_messageOk ? "alert-success" : "alert-danger")">@_message</div>
        }

        @if (_tab == "info")
        {
            <div class="card card-body">
                @if (_profile is not null)
                {
                    <p class="muted small">Mã khách hàng: <b>@_profile.CustomerCode</b></p>
                }
                <EditForm Model="_form" OnValidSubmit="SaveAsync" FormName="profile">
                    <DataAnnotationsValidator />
                    <div class="grid-2">
                        <div class="form-group">
                            <label class="form-label">Họ và tên *</label>
                            <InputText class="form-control" @bind-Value="_form.FullName" />
                            <ValidationMessage For="() => _form.FullName" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Ngày sinh</label>
                            <InputDate class="form-control" @bind-Value="_form.BirthDate" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Email</label>
                            <InputText class="form-control" @bind-Value="_form.Email" disabled />
                            <ValidationMessage For="() => _form.Email" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Số điện thoại</label>
                            <InputText class="form-control" @bind-Value="_form.PhoneNumber" />
                            <ValidationMessage For="() => _form.PhoneNumber" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Giới tính</label>
                            <InputSelect class="form-control" @bind-Value="_form.Gender">
                                <option value="">— Chọn —</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </InputSelect>
                        </div>
                        <div class="form-group">
                            <label class="form-label">CCCD / Hộ chiếu</label>
                            <InputText class="form-control" @bind-Value="_form.IdentityNumber" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Địa chỉ</label>
                        <InputText class="form-control" @bind-Value="_form.Address" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg" disabled="@(_busy || _customerId is null)">
                        @if (_busy) { <span class="spinner sm"></span> }
                        Lưu thay đổi
                    </button>
                </EditForm>
            </div>
        }
        else
        {
            <div class="card card-body">
                <EditForm Model="_pwd" OnValidSubmit="ChangePasswordAsync" FormName="change-password">
                    <DataAnnotationsValidator />
                    <div class="form-group">
                        <label class="form-label">Mật khẩu hiện tại</label>
                        <InputText type="password" class="form-control" @bind-Value="_pwd.CurrentPassword" autocomplete="current-password" />
                        <ValidationMessage For="() => _pwd.CurrentPassword" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Mật khẩu mới (tối thiểu 8 ký tự)</label>
                        <InputText type="password" class="form-control" @bind-Value="_pwd.NewPassword" autocomplete="new-password" />
                        <ValidationMessage For="() => _pwd.NewPassword" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Nhập lại mật khẩu mới</label>
                        <InputText type="password" class="form-control" @bind-Value="_pwd.ConfirmPassword" autocomplete="new-password" />
                        <ValidationMessage For="() => _pwd.ConfirmPassword" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg" disabled="@_busy">Đổi mật khẩu</button>
                </EditForm>
            </div>
        }
    }
</div>

@code {
    private UpdateCustomerRequest _form = new();
    private readonly ChangePasswordRequest _pwd = new();
    private CustomerResponse? _profile;
    private long? _customerId;
    private string _tab = "info";
    private bool _loading = true;
    private bool _busy;
    private string? _message;
    private bool _messageOk;
    private string? _warning;

    protected override async Task OnInitializedAsync()
    {
        if (!await Auth.RequireLoginAsync(Nav)) return;

        try
        {
            _profile = await CustomerSvc.GetProfileAsync();
            _customerId = _profile.Id;
            Fill(_profile);
        }
        catch (ApiException ex)
        {
            // Backend chưa có API "hồ sơ của tôi" → hiển thị thông tin tối thiểu từ token
            _warning = ex.Message;
            _customerId = Auth.CustomerId;
            _form = new UpdateCustomerRequest { FullName = Auth.CustomerName, Email = Auth.Email };
        }
        finally
        {
            _loading = false;
        }
    }

    private void Fill(CustomerResponse c)
    {
        _form = new UpdateCustomerRequest
        {
            FullName = c.FullName, Email = c.Email, PhoneNumber = c.PhoneNumber, BirthDate = c.BirthDate,
            Gender = c.Gender, IdentityNumber = c.IdentityNumber, Address = c.Address
        };
    }

    private async Task SaveAsync()
    {
        if (_customerId is null) return;
        _busy = true;
        _message = null;
        try
        {
            var saved = await CustomerSvc.UpdateProfileAsync(_customerId.Value, _form);
            _profile = saved;
            Fill(saved);
            Auth.UpdateName(saved.FullName);
            Say("Đã cập nhật hồ sơ.", true);
        }
        catch (ApiException ex)
        {
            Say(ex.Message, false);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ChangePasswordAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            await CustomerSvc.ChangePasswordAsync(_pwd);
            _pwd.CurrentPassword = _pwd.NewPassword = _pwd.ConfirmPassword = "";
            Say("Đã đổi mật khẩu.", true);
        }
        catch (ApiException ex)
        {
            Say(ex.Message, false);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Say(string text, bool ok)
    {
        _message = text;
        _messageOk = ok;
    }
}
