@page "/services"
@inject ApiClient Api
@inject AuthState Auth
@inject BookingService Bookings
@inject NavigationManager Nav

<PageTitle>Dịch vụ – @HotelInfo.Name</PageTitle>
<div class="container section">
    <h1>Dịch vụ khách sạn</h1>
    <p>Chọn dịch vụ cho booking đang lưu trú. Nhân viên sẽ tiếp nhận và xác nhận yêu cầu.</p>
    @if (_message is not null) { <p role="status">@_message</p> }
    @if (_services is null) { <Loading /> }
    else
    {
        @if (Auth.IsAuthenticated)
        {
            <label>Booking đang lưu trú
                <select class="form-control" @bind="_bookingId">
                    <option value="0">Chọn booking</option>
                    @foreach (var b in _stays) { <option value="@b.Id">@b.BookingCode</option> }
                </select>
            </label>
            <label>Số lượng <input class="form-control" type="number" min="1" max="100" @bind="_quantity" /></label>
            <label>Ghi chú <input class="form-control" maxlength="500" @bind="_note" /></label>
        }
        <div class="grid-rooms-home">
            @foreach (var s in _services)
            {
                <article class="card card-body">
                    <h2>@s.TenDichVu</h2><p>@s.MoTa</p>
                    <p>@Fmt.Money(s.DonGia) / @s.DonViTinh</p>
                    <button class="btn btn-primary" disabled="@_busy" @onclick="() => Request(s.Id)">Yêu cầu dịch vụ</button>
                </article>
            }
        </div>
        @if (Auth.IsAuthenticated)
        {
            <h2>Yêu cầu của tôi</h2>
            @foreach (var request in _requests)
            {
                <p>@(_services.FirstOrDefault(x => x.Id == request.DichVuId)?.TenDichVu ?? "Dịch vụ") · @request.SoLuong · @Status(request.TrangThai)</p>
            }
        }
    }
</div>
@code {
    private sealed record Service(long Id, string TenDichVu, string DonViTinh, decimal DonGia, string? MoTa);
    private sealed record ServiceUse(long DichVuId, decimal SoLuong, string TrangThai);
    private sealed record Page<T>(List<T> Items);
    private List<Service>? _services;
    private List<QuanLyKhachSan.Web.Models.Booking.BookingListItem> _stays = [];
    private List<ServiceUse> _requests = [];
    private long _bookingId;
    private int _quantity = 1;
    private string? _note, _message;
    private bool _busy;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _services = (await Api.GetAsync<Page<Service>>("v1/services?pageSize=100")).Items;
            await Auth.EnsureInitializedAsync();
            if (Auth.IsAuthenticated)
            {
                _stays = (await Bookings.GetMyBookingsAsync()).Where(x => x.Status == "DANG_O").ToList();
                await LoadRequests();
            }
        }
        catch (ApiException ex) { _services ??= []; _message = ex.Message; }
    }
    private async Task LoadRequests() => _requests = (await Api.GetAsync<Page<ServiceUse>>("v1/service-requests?pageSize=100")).Items;
    private async Task Request(long id)
    {
        if (!await Auth.RequireLoginAsync(Nav)) return;
        if (_bookingId == 0 || _quantity is < 1 or > 100) { _message = "Chọn booking đang lưu trú và số lượng từ 1 đến 100."; return; }
        _busy = true;
        try
        {
            await Api.PostAsync<object>("v1/service-requests", new { booking_id = _bookingId, service_id = id, quantity = _quantity, note = _note });
            _message = "Đã gửi yêu cầu dịch vụ.";
            await LoadRequests();
        }
        catch (ApiException ex) { _message = ex.Message; }
        finally { _busy = false; }
    }
    private static string Status(string value) => value switch { "CHO_XU_LY" => "Chờ xử lý", "DANG_XU_LY" => "Đang xử lý", "HOAN_THANH" => "Hoàn thành", "DA_HUY" => "Đã hủy", _ => value };
}
