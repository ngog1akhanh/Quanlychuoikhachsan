@page "/"
@inject NavigationManager Nav
@inject BookingState State
@inject RoomService Rooms

<PageTitle>@HotelInfo.Name – Đặt phòng trực tuyến</PageTitle>

<section class="booking-hero">
    <div class="booking-hero-shade"></div>
    <div class="container booking-hero-inner">
        <div class="hero-copy">
            <span class="hero-kicker"><span class="kicker-dot"></span> TRẢI NGHIỆM NGHỈ DƯỠNG ĐÁNG NHỚ</span>
            <h1>Một kỳ nghỉ<br /><em>theo cách của bạn.</em></h1>
            <p>@HotelInfo.Slogan. Khám phá không gian lưu trú tinh tế, chọn căn phòng phù hợp và đặt trực tuyến chỉ trong vài bước.</p>
            <div class="hero-actions">
                <a class="btn btn-lime btn-lg" href="rooms">Khám phá phòng <span aria-hidden="true">↗</span></a>
                <a class="hero-text-link" href="#trai-nghiem">Khám phá khách sạn <span aria-hidden="true">↓</span></a>
            </div>
            <div class="hero-proof">
                <div class="proof-avatars"><span>H</span><span>G</span><span>K</span></div>
                <div><strong>Đặt phòng dễ dàng</strong><small>Chủ động chọn phòng và thời gian lưu trú</small></div>
            </div>
        </div>
        <div class="hero-note">
            <span class="note-icon">✦</span>
            <div><strong>Stay a little longer.</strong><small>Thoải mái tận hưởng từng khoảnh khắc.</small></div>
        </div>
    </div>
    <div class="hero-bottom-label"><span>01</span> / NGHỈ NGƠI · KHÁM PHÁ · TẬN HƯỞNG</div>
</section>

<div class="container search-section">
    <div class="search-intro"><span class="section-kicker">BẮT ĐẦU HÀNH TRÌNH</span><h2>Tìm kỳ nghỉ của bạn</h2><p>Chọn ngày lưu trú và số khách để tìm phòng phù hợp.</p></div>
    <RoomSearchForm Query="_query" OnSearch="SearchAsync" />
</div>

<section class="section container" id="trai-nghiem">
    <div class="section-heading-row">
        <div class="section-head section-head-left">
            <div class="section-kicker">KHÔNG GIAN CỦA BẠN</div>
            <h2>Nghỉ ngơi theo<br />phong cách riêng.</h2>
            <p>Từ những căn phòng ấm cúng đến suite rộng rãi, mỗi lựa chọn đều mang đến sự thoải mái cho chuyến đi của bạn.</p>
        </div>
        <a class="text-link" href="rooms">Xem tất cả phòng <span>↗</span></a>
    </div>
    @if (_catalogError is not null) { <p role="status">@_catalogError</p> }
    <div class="grid-rooms-home">
        @foreach (var t in Highlights)
        {
            <article class="card type-card home-room-card">
                <a class="home-room-image" href="@HighlightUrl(t)">
                    <img src="@RoomImages.Cover(t)" alt="@t.RoomTypeName" loading="lazy" />
                    <span class="image-tag">@t.RoomTypeName</span>
                    <span class="image-arrow">↗</span>
                </a>
                <div class="body">
                    <div class="room-card-topline"><span>PHÒNG NGHỈ</span><span>✦ ĐƯỢC YÊU THÍCH</span></div>
                    <h3>@t.RoomTypeName</h3>
                    <p class="muted small room-teaser">@t.Description</p>
                    <div class="home-room-bottom">
                        <div><small>Giá từ</small><div class="price">@Fmt.Money(t.BaseNightlyPrice)<small>/ đêm</small></div></div>
                        <a class="round-link" href="@HighlightUrl(t)" aria-label="Xem @t.RoomTypeName">↗</a>
                    </div>
                </div>
            </article>
        }
    </div>
</section>

<section class="experience-band">
    <div class="container experience-inner">
        <div class="experience-copy">
            <div class="section-kicker">CHÚ TRỌNG TỪNG CHI TIẾT</div>
            <h2>Không chỉ là nơi để ở.<br /><em>Là nơi để tận hưởng.</em></h2>
            <p>Chúng tôi giúp bạn chủ động trong từng bước đặt phòng — từ lựa chọn không gian, giữ phòng đến theo dõi xác nhận đặt chỗ.</p>
            <a class="btn btn-forest" href="rooms">Chọn phòng ngay <span>↗</span></a>
        </div>
        <div class="experience-points">
            <div class="experience-point"><span class="point-icon">⌂</span><div><h3>Chọn đúng phòng bạn cần</h3><p>Xem thông tin, tiện nghi, diện tích và mức giá trước khi quyết định.</p></div><span class="point-no">01</span></div>
            <div class="experience-point"><span class="point-icon">◷</span><div><h3>Giữ phòng trong @HotelInfo.HoldMinutes phút</h3><p>Thời gian giữ phòng giúp bạn hoàn tất thông tin và thanh toán thuận tiện.</p></div><span class="point-no">02</span></div>
            <div class="experience-point"><span class="point-icon">♡</span><div><h3>Theo dõi đặt phòng dễ dàng</h3><p>Quản lý thông tin đặt chỗ, trạng thái thanh toán và lịch sử ngay trên tài khoản.</p></div><span class="point-no">03</span></div>
        </div>
    </div>
</section>

<section class="section container" id="chinh-sach">
    <div class="section-head">
        <div class="section-kicker">AN TÂM TRƯỚC MỖI CHUYẾN ĐI</div>
        <h2>Thông tin bạn cần biết</h2>
        <p>Minh bạch thông tin để bạn an tâm lên kế hoạch cho kỳ nghỉ.</p>
    </div>
    <div class="policy-grid">
        @foreach (var p in HotelInfo.Policies)
        {
            <div class="policy-item"><span class="policy-mark">✳</span><h3>@p.Title</h3><p>@p.Text</p></div>
        }
    </div>
    <div class="contact-ribbon"><div><span class="section-kicker">CẦN HỖ TRỢ?</span><h3>Chúng tôi luôn sẵn sàng giúp bạn.</h3><p>@HotelInfo.Address</p></div><div class="contact-actions"><a href="tel:@HotelInfo.PhoneRaw">☎ @HotelInfo.Phone</a><a href="mailto:@HotelInfo.Email">✉ Gửi email</a></div></div>
</section>

@code {
    private RoomSearchQuery _query = new();

    private List<PublicRoom> Highlights = [];
    private string? _catalogError;
    private string HighlightUrl(PublicRoom room) => $"rooms?{_query.ToQueryString()}&type={Uri.EscapeDataString(room.RoomTypeCode)}";

    protected override async Task OnInitializedAsync()
    {
        try { Highlights = await Rooms.GetHighlightsAsync(); }
        catch (ApiException ex) { _catalogError = ex.Message; }
    }

    private Task SearchAsync(RoomSearchQuery q)
    {
        State.Query = q.Clone();
        State.HasSearched = false;
        Nav.NavigateTo("rooms?" + q.ToQueryString());
        return Task.CompletedTask;
    }
}
