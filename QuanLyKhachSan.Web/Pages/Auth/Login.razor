@page "/login"
@inject AuthService AuthSvc
@inject NavigationManager Nav

<PageTitle>Đăng nhập – @HotelInfo.Name</PageTitle>

<div class="container">
    <div class="auth-wrap">
        <div class="card auth-card">
            <h1>Đăng nhập</h1>
            <p class="muted text-center">Đăng nhập để đặt phòng và theo dõi booking của bạn.</p>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger">@_error</div>
            }

            <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="login">
                <DataAnnotationsValidator />
                <div class="form-group">
                    <label class="form-label">Email hoặc số điện thoại</label>
                    <InputText class="form-control" @bind-Value="_model.Identifier" autocomplete="username" />
                    <ValidationMessage For="() => _model.Identifier" />
                </div>
                <div class="form-group">
                    <label class="form-label">Mật khẩu</label>
                    <InputText type="password" class="form-control" @bind-Value="_model.Password" autocomplete="current-password" />
                    <ValidationMessage For="() => _model.Password" />
                </div>
                <button type="submit" class="btn btn-primary btn-lg btn-block" disabled="@_busy">
                    @if (_busy) { <span class="spinner sm"></span> }
                    Đăng nhập
                </button>
            </EditForm>

            <div class="auth-links">
                <a href="forgot-password">Quên mật khẩu?</a>
                <a href="register">Chưa có tài khoản? Đăng ký</a>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private readonly LoginRequest _model = new();
    private bool _busy;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await AuthSvc.LoginAsync(_model);
            Nav.NavigateTo(SafeReturnUrl());
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    // Chỉ cho phép quay lại đường dẫn nội bộ (chống open-redirect)
    private string SafeReturnUrl()
        => !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\")
            ? ReturnUrl
            : "/";
}
