@page "/forgot-password"
@inject AuthService AuthSvc

<PageTitle>Quên mật khẩu – @HotelInfo.Name</PageTitle>

<div class="container">
    <div class="auth-wrap">
        <div class="card auth-card">
            <h1>Quên mật khẩu</h1>

            @if (_sent)
            {
                <div class="alert alert-success">
                    Nếu email <b>@_model.Email</b> tồn tại trong hệ thống, chúng tôi đã gửi hướng dẫn đặt lại mật khẩu.
                </div>
                <a class="btn btn-navy btn-block" href="login">Về trang đăng nhập</a>
            }
            else
            {
                <p class="muted text-center">Nhập email đã đăng ký, hệ thống sẽ gửi liên kết hoặc mã OTP để tạo mật khẩu mới.</p>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger">@_error</div>
                }

                <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="forgot">
                    <DataAnnotationsValidator />
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" @bind-Value="_model.Email" />
                        <ValidationMessage For="() => _model.Email" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg btn-block" disabled="@_busy">
                        @if (_busy) { <span class="spinner sm"></span> }
                        Gửi yêu cầu
                    </button>
                </EditForm>
                <div class="auth-links"><a href="login">← Quay lại đăng nhập</a><span></span></div>
            }
        </div>
    </div>
</div>

@code {
    private readonly ForgotPasswordRequest _model = new();
    private bool _busy;
    private bool _sent;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await AuthSvc.ForgotPasswordAsync(_model);
            _sent = true;
        }
        catch (ApiException ex)
        {
            _error = ex.StatusCode == 404
                ? "Backend chưa có chức năng quên mật khẩu (cần API POST /v1/auth/forgot-password)."
                : ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
