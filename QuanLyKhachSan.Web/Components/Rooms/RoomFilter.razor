<div class="filter-bar">
    <button type="button" class="chip @(Filter.RoomTypeCode == "" ? "on" : "")" @onclick='() => SetType("")'>Tất cả</button>
    @foreach (var t in Types)
    {
        var code = t.Code;
        <button type="button" class="chip @(Filter.RoomTypeCode == code ? "on" : "")" @onclick="() => SetType(code)">@t.Name</button>
    }

    <select class="form-control" value="@Filter.ViewType" @onchange="OnViewChanged">
        <option value="">Mọi view</option>
        @foreach (var v in Views)
        {
            <option value="@v">@v</option>
        }
    </select>

    <select class="form-control" value="@Filter.MaxPrice.ToString("0")" @onchange="OnPriceChanged">
        <option value="0">Mọi mức giá</option>
        <option value="1000000">Đến 1 triệu</option>
        <option value="2000000">Đến 2 triệu</option>
        <option value="4000000">Đến 4 triệu</option>
    </select>

    <select class="form-control" value="@Filter.Sort" @onchange="OnSortChanged">
        <option value="price_asc">Giá thấp → cao</option>
        <option value="price_desc">Giá cao → thấp</option>
    </select>
</div>

@code {
    /// <summary>Toàn bộ phòng trả về từ API (chưa lọc) – để dựng danh sách loại phòng / view.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<PublicRoom> Rooms { get; set; } = Array.Empty<PublicRoom>();
    [Parameter, EditorRequired] public RoomFilterState Filter { get; set; } = new();
    [Parameter] public EventCallback FilterChanged { get; set; }

    private IEnumerable<(string Code, string Name)> Types =>
        Rooms.GroupBy(r => r.RoomTypeCode).Select(g => (g.Key, g.First().RoomTypeName));

    private IEnumerable<string> Views =>
        Rooms.Select(r => r.ViewType).Where(v => !string.IsNullOrWhiteSpace(v)).Distinct().Select(v => v!);

    private Task SetType(string code)
    {
        Filter.RoomTypeCode = code;
        return FilterChanged.InvokeAsync();
    }

    private Task OnViewChanged(ChangeEventArgs e)
    {
        Filter.ViewType = e.Value?.ToString() ?? "";
        return FilterChanged.InvokeAsync();
    }

    private Task OnPriceChanged(ChangeEventArgs e)
    {
        Filter.MaxPrice = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        return FilterChanged.InvokeAsync();
    }

    private Task OnSortChanged(ChangeEventArgs e)
    {
        Filter.Sort = e.Value?.ToString() ?? "price_asc";
        return FilterChanged.InvokeAsync();
    }
}
