<div class="card room-card @(Selected ? "selected" : "")">
    <div class="thumb">
        <a href="@DetailHref"><img src="@RoomImages.Cover(Room)" alt="@Room.RoomTypeName" loading="lazy" /></a>
        <span class="room-no">Phòng @Room.RoomNumber</span>
        @if (Selected) { <span class="tick">✓ Đã chọn</span> }
    </div>
    <div class="info">
        <h3><a href="@DetailHref">@Room.RoomTypeName</a></h3>
        <div class="room-meta">
            @if (!string.IsNullOrEmpty(Room.Floor)) { <span>🏢 Tầng @Room.Floor</span> }
            <span>🌅 @(string.IsNullOrEmpty(Room.ViewType) ? "Không ghi view" : Room.ViewType)</span>
            @if (Room.AreaM2 is not null) { <span>📐 @Room.AreaM2.Value.ToString("0.#") m²</span> }
            <span>👥 @Room.MaxAdults người lớn@(Room.MaxChildren > 0 ? $", {Room.MaxChildren} trẻ em" : "")</span>
        </div>
        @if (!string.IsNullOrEmpty(Room.Description))
        {
            <div class="room-desc">@Truncate(Room.Description, 110)</div>
        }
        <div class="room-foot">
            <div class="room-price">
                <b>@Fmt.Money(Room.UnitPrice)</b>
                <small>/đêm</small>
                @if (Nights > 0)
                {
                    <small><br />@Nights đêm: @Fmt.Money(Room.UnitPrice * Nights)</small>
                }
            </div>
            <div class="room-actions">
                <a class="btn btn-outline btn-sm" href="@DetailHref">Xem chi tiết</a>
                <button type="button" class="btn @(Selected ? "btn-outline" : "btn-primary") btn-sm" @onclick="() => OnToggle.InvokeAsync(Room)">
                    @(Selected ? "Bỏ chọn" : "Chọn phòng")
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PublicRoom Room { get; set; } = default!;
    [Parameter] public int Nights { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public string DetailHref { get; set; } = "#";
    [Parameter] public EventCallback<PublicRoom> OnToggle { get; set; }

    private static string Truncate(string s, int max) => s.Length <= max ? s : s[..max].TrimEnd() + "…";
}
