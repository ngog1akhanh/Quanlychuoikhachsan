<article class="card room-card @(SelectedCount > 0 ? "selected" : "")">
    <a class="thumb" href="@DetailHref"><img src="@RoomImages.Cover(Room)" alt="@Room.RoomTypeName" loading="lazy" /></a>
    <div class="info">
        <h3><a href="@DetailHref">@Room.RoomTypeName</a></h3>
        @BedOptions
        <div class="room-meta">
            <span>@Room.BedLabel</span>
            @if (Room.AreaM2 is not null) { <span>@Room.AreaM2.Value.ToString("0.#") m²</span> }
            <span>@Room.MaxAdults người lớn@(Room.MaxChildren > 0 ? $", {Room.MaxChildren} trẻ em" : "")</span>
        </div>
        @if (AvailableCount is > 0 and < 5) { <p class="availability-note">Chỉ còn @AvailableCount phòng trong thời gian này</p> }
        <div class="room-foot">
            <div class="room-price"><small>Giá từ</small><b>@Fmt.Money(Room.UnitPrice)</b><small>/đêm (bình quân)</small></div>
            <div class="room-actions">
                <a class="btn btn-outline btn-sm" href="@DetailHref">Xem chi tiết</a>
                <button class="btn btn-primary btn-sm" disabled="@(SelectedCount >= (SelectionLimit ?? AvailableCount))" @onclick="OnAdd">Chọn phòng</button>
                @if (SelectedCount > 0)
                {
                    <span>Đã chọn @SelectedCount</span>
                    <button class="btn btn-outline btn-sm" @onclick="OnRemove" aria-label="Bớt một phòng">−</button>
                }
            </div>
        </div>
    </div>
</article>
@code {
    [Parameter, EditorRequired] public PublicRoom Room { get; set; } = default!;
    [Parameter] public RenderFragment? BedOptions { get; set; }
    [Parameter] public int Nights { get; set; }
    [Parameter] public int? SelectionLimit { get; set; }
    [Parameter] public int AvailableCount { get; set; }
    [Parameter] public int SelectedCount { get; set; }
    [Parameter] public string DetailHref { get; set; } = "#";
    [Parameter] public EventCallback OnAdd { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
}
