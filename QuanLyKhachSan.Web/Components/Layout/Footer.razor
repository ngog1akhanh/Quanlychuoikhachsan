<footer class="site-footer">
    <div class="container footer-grid">
        <div>
            <h4>@HotelInfo.Name</h4>
            <p>@HotelInfo.Slogan.</p>
            <p>📍 @HotelInfo.Address</p>
        </div>
        <div>
            <h4>Khám phá</h4>
            <a href="/">Trang chủ</a>
            <a href="rooms">Tìm &amp; đặt phòng</a>
            <a href="thong-tin-chinh-sach">Chính sách</a>
        </div>
        <div>
            <h4>Tài khoản</h4>
            <a href="login">Đăng nhập</a>
            <a href="register">Đăng ký</a>
            <a href="account/bookings">Booking của tôi</a>
        </div>
        <div>
            <h4>Liên hệ</h4>
            <a href="tel:@HotelInfo.PhoneRaw">☎ @HotelInfo.Phone</a>
            <a href="mailto:@HotelInfo.Email">✉ @HotelInfo.Email</a>
            <p class="small">Nhận phòng @HotelInfo.CheckInTime · Trả phòng @HotelInfo.CheckOutTime</p>
        </div>
    </div>
    <div class="footer-bottom">© @DateTime.Now.Year @HotelInfo.Name. Bảo lưu mọi quyền.</div>
</footer>
